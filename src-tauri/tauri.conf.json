{
  "$schema": "./config/v2.json",
  "productName": "weport",
  "version": "1.0.0",
  "identifier": "monoslab.weport.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "weport",
        "label": "main",
        "url": "index.html",
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "visible": false,
        "width": 800,
        "height": 600,
        "minWidth": 600,
        "minHeight": 200
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/weport.ico"
    ]
  }
}
