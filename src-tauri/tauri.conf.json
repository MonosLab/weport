{
  "$schema": "./config/v2.json",
  "productName": "weport",
  "version": "1.0.1",
  "identifier": "monoslab.weport.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "weport",
        "label": "main",
        "url": "index.html",
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "visible": false,
        "width": 800,
        "height": 600,
        "minWidth": 600,
        "minHeight": 200
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/weport.ico"
    ],
    "windows": {
      "wix": {
        "language": ["ko-KR"],
        "template": "main.wxs"
      },
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": true,
        "installerIcon": "weport.ico",
        "startMenuFolder": "Monoslab",
        "template": "main.nsi"
        
      },
      "certificateThumbprint": "E0742EEA0F8498394931BD3128B5EFADEDB5B743",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "publisher": "Monoslab",
    "copyright": "ⓒ 2026 Monoslab. All rights reserved."
  }
}
